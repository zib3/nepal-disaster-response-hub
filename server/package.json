{
  "name": "nepal-disaster-response-server",
  "version": "1.0.0",
  "description": "Server-side API for Nepal Disaster Response System",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js < /dev/null",
    "dev": "nodemon src/index.js < /dev/null",
    "seed": "node src/seeders/seeder.js",
    "seed:dev": "NODE_ENV=development node src/seeders/seeder.js",
    "seed:comprehensive": "node comprehensive-seed.js",
    "seed:enhanced": "node seed-enhanced-data.js",
    "init:db": "node init-db.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "disaster-response",
    "nepal",
    "emergency",
    "api"
  ],
  "author": "Nepal Disaster Response Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "natural": "^8.1.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "sharp": "^0.34.3",
    "socket.io": "^4.7.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
